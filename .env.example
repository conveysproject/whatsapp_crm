# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres container password; must match the password in DATABASE_URL
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://WBMSG:change-me@localhost:5432/WBMSG_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Meilisearch ─────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-master-key

# ─── Auth (WBMSG own login) ──────────────────────────────────────────────────
# API: generate the signing key with `cd apps/api && npx tsx scripts/gen-auth-keys.ts`
AUTH_JWT_PRIVATE_KEY=REPLACE_ME
AUTH_JWT_KID=REPLACE_ME
AUTH_CODE_PEPPER=REPLACE_ME_32_PLUS_CHARS
# API and web: same value on both, 32+ characters
AUTH_BFF_SECRET=REPLACE_ME_32_PLUS_CHARS

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── Turborepo Remote Cache ───────────────────────────────────────────────────
TURBO_TOKEN=
TURBO_TEAM=

# ─── Meta / WhatsApp Cloud API ───────────────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=REPLACE_ME
NEXT_PUBLIC_META_REDIRECT_URI=http://localhost:3000/connect-waba/callback
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=WBMSG_verify_2026
WA_WEBHOOK_SECRET=

# ─── OpenAI (Whisper voice transcription) ────────────────────────────────────
OPENAI_API_KEY=

# ─── Anthropic (Claude AI features) ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Stripe (Billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ENTERPRISE=
STRIPE_WEBHOOK_SECRET=

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
DD_API_KEY=
DD_SITE=datadoghq.com

# Plivo-compatible public API (docs/prd-plivo-compatible-api.md)
PUBLIC_API_ENABLED=false
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts API auth tokens at rest; losing it invalidates callback signing.
PUBLIC_API_TOKEN_KEY=
# Requests per minute per client IP + credential
PUBLIC_API_RATE_LIMIT=300
# Rollout allow-list for the public API: comma-separated organization ids. Empty/unset = all orgs.
PUBLIC_API_ALLOWED_ORGS=
# Coarse per-IP pre-auth flood guard (default: 10x PUBLIC_API_RATE_LIMIT)
# PUBLIC_API_PREAUTH_RATE_LIMIT=3000

# Parent / child organizations (docs/prd-parent-child-orgs.md, docs/parent-child-orgs.md)
# No global switch: the per-organization capability (set by a super admin) is the only gate.
# Destinations per minute per API key + child org when a parent key sends for a child (default 120)
# PUBLIC_API_CHILD_RATE_LIMIT=120

# Public API usage tracking (docs/prd-api-usage-tracking.md)
# Days to keep raw per-request log rows (daily rollups are kept indefinitely)
API_REQUEST_LOG_RETENTION_DAYS=30
# 0..1: share of SUCCESSFUL requests written to the raw log (errors are always logged; rollup counts are always exact)
API_REQUEST_LOG_SUCCESS_SAMPLE_RATE=1
# How often the in-memory usage buffer is flushed to the database (ms)
API_USAGE_FLUSH_MS=5000
API_UNATTRIBUTED_RAW_PER_MIN=300

# Public API payload logging (off by default). Stores redacted request/response bodies and callback attempts.
API_PAYLOAD_LOGGING_ENABLED=false
# Days to keep stored payloads and callback attempts (default 365, minimum 90).
API_PAYLOAD_RETENTION_DAYS=365

# Server-to-server key for the white-label sign-in lookup (GET /v1/public/brand/:slug). Set the SAME value (at least 32
# characters, random) on the API and on the web server (server-only, never NEXT_PUBLIC_). The web server then gets a high
# rate limit instead of sharing the per-IP limit of its egress address. Unset or shorter than 32 (like this placeholder) = feature off.
PUBLIC_BRAND_SERVER_KEY=changeme
