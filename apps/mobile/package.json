  "devDependencies": {
    "@WBMSG/tsconfig": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "typescript": "^6.0.3"
  },
  "expo": {
    "install": {
